# Copy to .env for local development (or run: node scripts/setup-env.mjs, which fills in fresh secrets).
# Never commit a real .env. In production, inject these from your secret manager.

NODE_ENV=development
DATABASE_URL=postgresql://signaldesk:signaldesk@localhost:54329/signaldesk
PORT=4000

# Browser origins allowed to make state-changing requests and open WebSockets (comma separated).
APP_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API. Local dev has one: the Next.js rewrite.
TRUST_PROXY_HOPS=1

# 32 random bytes, base64. Encrypts MFA secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# webpush | log | disabled. "log" accepts pushes without sending anything, for local UI work.
PUSH_TRANSPORT=disabled
# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Second key for the public results page. Stays useless without a recorded, current compliance
# approval. Leave false until your compliance review is complete: see docs/COMPLIANCE_CHECKLIST.md.
PUBLIC_PERFORMANCE_ENABLED=false

# Email: sign-up codes, subscription enquiries to support, and account messages.
#   smtp      real delivery. Gmail works with an app password (smtp.gmail.com, port 587).
#   file      writes each message to EMAIL_FILE_DIR. Development only; refused in production.
#   disabled  nothing is sent, and sign-up says so instead of pretending.
EMAIL_TRANSPORT=disabled
EMAIL_FROM=
EMAIL_FILE_DIR=
SMTP_HOST=
SMTP_PORT=587
# false: STARTTLS on port 587, which is then required. true: TLS from the start, port 465.
SMTP_SECURE=false
SMTP_USER=
# Keep this only in your real .env or secret manager. Never commit it.
SMTP_PASS=

# Run the background worker inside the API process (simple single-node setups and local dev).
# Production should run it as a separate process: npm run start:worker
RUN_WORKER_IN_API=true

# Web app: where its server forwards /api/* and where the browser opens its WebSocket.
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
