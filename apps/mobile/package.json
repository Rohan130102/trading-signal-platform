{
  "name": "@signaldesk/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "export:check": "expo export --platform android --platform ios --output-dir dist",
    "assets": "node scripts/generate-assets.mjs",
    "eas-build-post-install": "npm run build -w @signaldesk/domain --prefix ../.."
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@signaldesk/domain": "*",
    "@tanstack/react-query": "5.106.1",
    "expo": "58.0.23",
    "expo-build-properties": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.16",
    "expo-notifications": "58.1.8",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.7",
    "babel-preset-expo": "58.0.24",
    "expo-doctor": "1.21.6",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react"
      ]
    }
  }
