# Where the app finds the API. Copied to .env.local, never committed.
#
# Android emulator with `adb reverse tcp:4000 tcp:4000`, or iOS simulator:
#   EXPO_PUBLIC_API_URL=http://localhost:4000
# Android emulator without adb reverse:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# A real phone on the same Wi-Fi. Use this computer's address, because "localhost" on a phone is the phone:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
# Leave it unset in development and the app uses the address Expo is being served from, on port 4000.
#
# Preview and production builds must use HTTPS. The app refuses to run otherwise.
EXPO_PUBLIC_API_URL=
