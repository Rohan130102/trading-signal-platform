{
  "name": "@signaldesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/scripts/seed.js",
    "admin:create": "node dist/scripts/create-admin.js",
    "openapi": "node dist/scripts/export-openapi.js",
    "test:integration": "vitest run --config vitest.config.ts",
    "admin:reset": "node dist/scripts/reset-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@signaldesk/domain": "0.1.0",
    "argon2": "0.45.2",
    "helmet": "8.3.0",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "embedded-postgres": "18.6.0-beta.19"
  }
}
