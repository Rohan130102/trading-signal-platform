{
  "name": "signaldesk",
  "private": true,
  "version": "0.1.0",
  "description": "Trading-signal broadcasting platform. Communication only: it never places orders.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "npm run db:migrate -w @signaldesk/api",
    "db:seed": "npm run db:seed -w @signaldesk/api",
    "admin:create": "npm run admin:create -w @signaldesk/api",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @signaldesk/domain && npm run build -w @signaldesk/api && npm run build -w @signaldesk/web",
    "start:api": "npm run start -w @signaldesk/api",
    "start:worker": "npm run start:worker -w @signaldesk/api",
    "start:web": "npm run start -w @signaldesk/web",
    "typecheck": "npm run build -w @signaldesk/domain && npm run typecheck -w @signaldesk/domain && npm run typecheck -w @signaldesk/api && npm run typecheck -w @signaldesk/web && npm run typecheck -w @signaldesk/mobile",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test -w @signaldesk/domain",
    "test:integration": "npm run build -w @signaldesk/domain && npm run build -w @signaldesk/api && npm run test:integration -w @signaldesk/api",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/perf.mjs",
    "openapi": "npm run openapi -w @signaldesk/api",
    "admin:reset": "npm run admin:reset -w @signaldesk/api",
    "admin:make-master": "npm run admin:make-master -w @signaldesk/api",
    "data:reset-demo": "npm run data:reset-demo -w @signaldesk/api",
    "test:mobile": "npm run build -w @signaldesk/domain && npm test -w @signaldesk/mobile",
    "mobile": "npm start -w @signaldesk/mobile"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "web-push": "3.6.7",
    "ws": "8.22.1",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
